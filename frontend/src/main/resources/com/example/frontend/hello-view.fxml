<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #160f29;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://github.com/fxml/1" fx:controller="com.example.frontend.HelloController">

    <top>
        <HBox alignment="CENTER_RIGHT" prefHeight="65.0" spacing="10.0" style="-fx-background-color: #241942; -fx-border-color: #3b286b; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="myDivarButton" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand;" text="بازارچه من" />

                <Button fx:id="btnRegisterNav" mnemonicParsing="false" onAction="#onRegisterAdScreenClick" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand; -fx-background-radius: 6; -fx-border-radius: 6;" text="ثبت آگهی">
                    <padding>
                        <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
                    </padding>
                </Button>

                <Button fx:id="btnChatNav" mnemonicParsing="false" onAction="#onChatScreenClick" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand; -fx-background-radius: 6; -fx-border-radius: 6;" text="چت" />

                <!-- ❌ دکمه جداگانه «آگهی‌های من» حذف شد — فقط از منوی «دیوار من» در دسترس است -->
                <!-- ❌ دکمه «پشتیبانی» کاملاً حذف شد -->

                <Region HBox.hgrow="ALWAYS" />

                <!-- 🔍 اضافه شدن fx:id و رویداد فیلتر همزمان جستجو -->
                <TextField fx:id="searchField" onKeyReleased="#onSearchKeyReleased" prefHeight="35.0" prefWidth="230.0" promptText="جستجو..." style="-fx-background-color: #160f29; -fx-background-radius: 6; -fx-border-color: #3b286b; -fx-border-radius: 6; -fx-alignment: center-right; -fx-text-fill: white;">
                    <font>
                        <Font size="13.0" />
                    </font>
                </TextField>

                <!-- 🔍 فیلترها و مرتب‌سازی در ردیف بالا (به‌جای دکمه جداگانه) -->
                <TextField fx:id="minPriceField" onKeyReleased="#onTopBarFilterChanged" prefHeight="35.0" prefWidth="85.0" promptText="از قیمت" style="-fx-background-color: #160f29; -fx-background-radius: 6; -fx-border-color: #3b286b; -fx-border-radius: 6; -fx-alignment: center-right; -fx-text-fill: white;" />
                <TextField fx:id="maxPriceField" onKeyReleased="#onTopBarFilterChanged" prefHeight="35.0" prefWidth="85.0" promptText="تا قیمت" style="-fx-background-color: #160f29; -fx-background-radius: 6; -fx-border-color: #3b286b; -fx-border-radius: 6; -fx-alignment: center-right; -fx-text-fill: white;" />
                <ComboBox fx:id="sortFilterCombo" onAction="#onTopBarFilterChanged" prefHeight="35.0" prefWidth="115.0" promptText="مرتب‌سازی" style="-fx-background-color: #160f29; -fx-background-radius: 6; -fx-cursor: hand;" />
                <ComboBox fx:id="cityFilterCombo" onAction="#onTopBarFilterChanged" prefHeight="35.0" prefWidth="115.0" promptText="همه شهرها" style="-fx-background-color: #160f29; -fx-background-radius: 6; -fx-cursor: hand;" />

                <ImageView fitHeight="44.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#showHomeScreen" style="-fx-cursor: hand;">
                    <image>
                        <Image url="@logo.png" />
                    </image>
                </ImageView>
            </children>
            <padding>
                <Insets left="25.0" right="25.0" />
            </padding>
        </HBox>
    </top>

    <right>
        <VBox fx:id="categoryVBox" alignment="TOP_RIGHT" prefWidth="240.0" spacing="12.0" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <children>
                <Label text="دسته‌بندی‌ها" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="8.0" />
                    </VBox.margin>
                </Label>
                <!-- 🏷️ گزینه «همه محصولات» برای پاک کردن فیلتر دسته‌بندی -->
                <Button onAction="#onCategoryClick" alignment="BASELINE_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand; -fx-border-radius: 6; -fx-background-radius: 6;" text="همه محصولات" />
                <Button onAction="#onCategoryClick" alignment="BASELINE_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand; -fx-border-radius: 6; -fx-background-radius: 6;" text="املاک" />
                <Button onAction="#onCategoryClick" alignment="BASELINE_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand; -fx-border-radius: 6; -fx-background-radius: 6;" text="وسایل نقلیه" />
                <Button onAction="#onCategoryClick" alignment="BASELINE_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand; -fx-border-radius: 6; -fx-background-radius: 6;" text="کالای دیجیتال" />
                <Button onAction="#onCategoryClick" alignment="BASELINE_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand; -fx-border-radius: 6; -fx-background-radius: 6;" text="خانه و آشپزخانه" />
                <Button onAction="#onCategoryClick" alignment="BASELINE_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand; -fx-border-radius: 6; -fx-background-radius: 6;" text="خدمات" />
            </children>
            <padding>
                <Insets left="10.0" right="25.0" top="25.0" />
            </padding>
        </VBox>
    </right>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #160f29;" vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="15.0" style="-fx-background-color: #160f29;">
                    <children>
                        <Label text="آگهی‌های تازه" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <!-- این گریدپین اولیه با لود شدن دیتابیس جایگزین پویا می‌شود -->
                        <GridPane fx:id="dynamicAdsGrid" hgap="15.0" vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                        </GridPane>
                    </children>
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="10.0" top="25.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
