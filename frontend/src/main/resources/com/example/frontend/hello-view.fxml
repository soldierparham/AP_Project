<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #160f29;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.frontend.HelloController">

    <top>
        <HBox alignment="CENTER_RIGHT" prefHeight="65.0" spacing="20.0" style="-fx-background-color: #241942; -fx-border-color: #3b286b; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="myDivarButton" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand;" text="دیوار من" />

                <Button mnemonicParsing="false" onAction="#onRegisterAdClick" style="-fx-background-color: #ffc83b; -fx-text-fill: #160f29; -fx-background-radius: 6; -fx-cursor: hand;" text="ثبت آگهی">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                    <padding>
                        <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
                    </padding>
                </Button>
                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand;" text="چت" />
                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand;" text="پشتیبانی" />

                <Region HBox.hgrow="ALWAYS" />

                <TextField prefHeight="35.0" prefWidth="380.0" promptText="جستجو در همه آگهی‌ها..." style="-fx-background-color: #160f29; -fx-background-radius: 6; -fx-border-color: #3b286b; -fx-border-radius: 6; -fx-alignment: center-right; -fx-text-fill: white;">
                    <font>
                        <Font size="13.0" />
                    </font>
                </TextField>

                <ComboBox prefHeight="35.0" promptText="تهران" style="-fx-background-color: #160f29; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" />

                <Label text="دیوار" textFill="#ffc83b">
                    <font>
                        <Font name="System Bold" size="26.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets left="25.0" right="25.0" />
            </padding>
        </HBox>
    </top>

    <right>
        <VBox alignment="TOP_RIGHT" prefWidth="240.0" spacing="12.0" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <children>
                <Label text="دسته‌بندی‌ها" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="8.0" />
                    </VBox.margin>
                </Label>
                <Button alignment="BASELINE_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand;" text="املاک" />
                <Button alignment="BASELINE_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand;" text="وسایل نقلیه" />
                <Button alignment="BASELINE_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand;" text="کالای دیجیتال" />
                <Button alignment="BASELINE_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand;" text="خانه و آشپزخانه" />
                <Button alignment="BASELINE_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #b9a6df; -fx-cursor: hand;" text="خدمات" />
            </children>
            <padding>
                <Insets left="10.0" right="25.0" top="25.0" />
            </padding>
        </VBox>
    </right>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #160f29;" vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="15.0" style="-fx-background-color: #160f29;">
                    <children>
                        <Label text="آگهی‌های تازه" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <GridPane hgap="15.0" vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="140.0" prefHeight="140.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>

                                <HBox alignment="CENTER_RIGHT" prefHeight="130.0" spacing="12.0" style="-fx-background-color: #241942; -fx-background-radius: 6; -fx-border-color: #3b286b; -fx-border-radius: 6; -fx-padding: 12;" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <children>
                                        <VBox alignment="TOP_RIGHT" spacing="6.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="آیفون ۱۳ پرو مکس ۱۲۸ گیگ" textFill="WHITE" wrapText="true">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <Label text="وضعیت: در حد نو" textFill="#b9a6df" />
                                                <Region VBox.vgrow="ALWAYS" />
                                                <Label text="۴۵,۰۰۰,۰۰۰ تومان" textFill="#ffc83b">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <Label text="کمی پیش در سعادت‌آباد" textFill="#8575a3">
                                                    <font><Font size="11.0" /></font>
                                                </Label>
                                            </children>
                                        </VBox>
                                        <StackPane prefHeight="110.0" prefWidth="110.0" style="-fx-background-color: #160f29; -fx-background-radius: 4;" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_RIGHT" prefHeight="130.0" spacing="12.0" style="-fx-background-color: #241942; -fx-background-radius: 6; -fx-border-color: #3b286b; -fx-border-radius: 6; -fx-padding: 12;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <children>
                                        <VBox alignment="TOP_RIGHT" spacing="6.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="سانتافه ۲۰۱۶ فول آپشن" textFill="WHITE" wrapText="true">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <Label text="کارکرد: ۱۲۰,۰۰۰ کیلومتر" textFill="#b9a6df" />
                                                <Region VBox.vgrow="ALWAYS" />
                                                <Label text="۳,۴۰۰,۰۰۰,۰۰۰ تومان" textFill="#ffc83b">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <Label text="۲ ساعت پیش در نیاوران" textFill="#8575a3">
                                                    <font><Font size="11.0" /></font>
                                                </Label>
                                            </children>
                                        </VBox>
                                        <StackPane prefHeight="110.0" prefWidth="110.0" style="-fx-background-color: #160f29; -fx-background-radius: 4;" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_RIGHT" prefHeight="130.0" spacing="12.0" style="-fx-background-color: #241942; -fx-background-radius: 6; -fx-border-color: #3b286b; -fx-border-radius: 6; -fx-padding: 12;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <children>
                                        <VBox alignment="TOP_RIGHT" spacing="6.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="میز تحرير چوبی مدرن" textFill="WHITE" wrapText="true">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <Label text="نو همراه با کشو" textFill="#b9a6df" />
                                                <Region VBox.vgrow="ALWAYS" />
                                                <Label text="۲,۸۰۰,۰۰۰ تومان" textFill="#ffc83b">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <Label text="۵ ساعت پیش در چیتگر" textFill="#8575a3">
                                                    <font><Font size="11.0" /></font>
                                                </Label>
                                            </children>
                                        </VBox>
                                        <StackPane prefHeight="110.0" prefWidth="110.0" style="-fx-background-color: #160f29; -fx-background-radius: 4;" />
                                    </children>
                                </HBox>

                            </children>
                        </GridPane>
                    </children>
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="10.0" top="25.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>